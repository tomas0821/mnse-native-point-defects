&CONTROL
    calculation = 'scf'
    prefix      = 'null_rs'
    pseudo_dir  = '/home/tomas.rojas_s/pseudo'
    outdir      = './tmp_null_rs'
    verbosity   = 'high'
    disk_io     = 'medium'
/
&SYSTEM
    ibrav       = 0
    nat         = 4
    ntyp        = 3
    ecutwfc     = 120.0
    ecutrho     = 960.0
    occupations = 'smearing'
    smearing    = 'gaussian'
    degauss     = 0.01
    nbnd        = 40
    nspin       = 2
    starting_magnetization(1) = +0.5
    starting_magnetization(2) = -0.5
    starting_magnetization(3) = +0.0
/
&ELECTRONS
    conv_thr        = 1.0d-8
    mixing_beta     = 0.3
    electron_maxstep = 200
/
