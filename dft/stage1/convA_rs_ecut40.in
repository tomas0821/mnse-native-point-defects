  Mn2 2.7308000000 0.0000000000 2.7308000000
  Mn1 2.7308000000 2.7308000000 0.0000000000
  Se 0.0000000000 0.0000000000 2.7308000000
  Se 0.0000000000 2.7308000000 0.0000000000
  Se 2.7308000000 0.0000000000 0.0000000000
