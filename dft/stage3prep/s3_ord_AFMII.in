&CONTROL
    calculation = 'scf'
    prefix      = 's3_ord_AFMII'
    pseudo_dir  = '/home/tomas.rojas_s/pseudo'
    outdir      = './tmp_s3_ord_AFMII'
    tprnfor     = .true.
    tstress     = .true.
/
&SYSTEM
    ibrav       = 0
    nat         = 64
    ntyp        = 3
    ecutwfc     = 70.0
    ecutrho     = 560.0
    occupations = 'smearing'
    smearing    = 'gaussian'
    degauss     = 0.01
    nspin       = 2
    starting_magnetization(1) = +0.5
    starting_magnetization(2) = -0.5
    starting_magnetization(3) = +0.0
/
&ELECTRONS
    conv_thr        = 1.0d-8
    mixing_beta     = 0.3
    electron_maxstep = 200
/
